---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllFaqs } from '../data/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getTranslations } from '../i18n';
import { localizeFaqItems } from '../i18n/faq-full';

const locale = 'en' as const;
const t = getTranslations(locale);
const seo = resolvePageSeo('/faq/', locale);
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: t.faq.eyebrow, path: '/faq/' },
];

const faqs = localizeFaqItems(locale, getAllFaqs());
---

<BaseLayout
  locale={locale}
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/faq/',
    }),
    faqPageSchema(
      faqs.map((f, i) => ({
        num: String(i + 1).padStart(2, '0'),
        q: f.q,
        a: f.a.replace(/<[^>]+>/g, ''),
      })),
    ),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6">
        <SectionHeader
          eyebrow={t.faq.eyebrow}
          title={t.faq.title}
          desc={t.faq.subtitle}
          titleId="faq-page-title"
        />
      </div>
    </div>
  </section>

  <SiteFaqSection
    items={faqs}
    variant="full"
    titleId="faq-page-list"
    eyebrow={t.faq.eyebrow}
    title={t.faq.title}
    subtitle={t.faq.subtitle}
  />
</BaseLayout>
