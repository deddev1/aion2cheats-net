---
import '../../../../styles/product-cheat-page.css';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { productHub, productPages } from '../../../../data/products';
import { resolvePageSeo } from '../../../../config/seo';
import { breadcrumbSchema, itemListSchema, webPageSchema } from '../../../../utils/schema';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { productPath } from '../../../../utils/path';
import { Button } from '@/components/starwind/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/starwind/card';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/starwind/table';
import {
  NON_DEFAULT_LOCALES,
  getTranslations,
  isLocale,
  localizePath,
} from '../../../../i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: raw } = Astro.params;
if (!isLocale(raw) || raw === 'en') {
  return Astro.redirect('/products/aion-2-cheats/utilities/');
}
const locale = raw;
const t = getTranslations(locale);
const utilities = productPages.filter((p) => p.kind === 'utility');
const seo = resolvePageSeo('/products/aion-2-cheats/utilities/', locale);
const utilPath = localizePath(locale, '/products/aion-2-cheats/utilities/');
const hubPath = localizePath(locale, productHub.path);
const breadcrumbs = [
  { name: 'Home', path: localizePath(locale, '/') },
  { name: t.products.eyebrow, path: hubPath },
  { name: t.products.explore, path: utilPath },
];

const utilityUseCases: Record<string, string> = {
  'hwid-spoofer': 'New PC or hardware flag after a ban—reset how your machine appears before a new account.',
  ugc: 'Structured appeal and account recovery workflows when access is restricted.',
  'unlock-all': 'Local cosmetic preview and loadouts without buying every outfit on NCSOFT.',
};
---

<BaseLayout
  locale={locale}
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: utilPath,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      utilities.map((product) => ({
        name: product.title,
        url: productPath(product.slug, locale),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <header class="mt-6 max-w-3xl space-y-3">
        <h1 class="text-3xl font-bold uppercase md:text-4xl">{t.products.title}</h1>
        <p class="text-lg text-muted-foreground">{t.products.subtitle}</p>
      </header>

      <div class="mt-10 rounded-lg border border-border" tabindex="0" aria-label="Utility comparison">
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Utility</TableHead>
              <TableHead>Best for</TableHead>
              <TableHead>Product page</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {
              utilities.map((product) => (
                <TableRow>
                  <TableCell class="font-medium">{product.title}</TableCell>
                  <TableCell class="text-muted-foreground">
                    {utilityUseCases[product.slug] ?? product.desc}
                  </TableCell>
                  <TableCell>
                    <a href={productPath(product.slug, locale)} class="text-primary hover:underline">
                      {t.products.explore}
                    </a>
                  </TableCell>
                </TableRow>
              ))
            }
          </TableBody>
        </Table>
      </div>

      <ul class="mt-10 space-y-4">
        {
          utilities.map((product) => (
            <li>
              <Card>
                <CardHeader>
                  <CardTitle class="text-lg normal-case">
                    <a href={productPath(product.slug, locale)} class="hover:text-primary">
                      {product.title}
                    </a>
                  </CardTitle>
                </CardHeader>
                <CardContent class="space-y-2 text-sm text-muted-foreground">
                  <p>{product.desc}</p>
                  <p>
                    <strong class="text-foreground">Includes:</strong>{' '}
                    {product.features.slice(0, 4).join(' · ')}
                    {product.more > 0 ? ` · +${product.more} more` : ''}
                  </p>
                </CardContent>
              </Card>
            </li>
          ))
        }
      </ul>

      <div class="mt-10">
        <Button as="a" href={hubPath} variant="outline">{t.products.viewAll}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
