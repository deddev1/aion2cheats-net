---
import '../styles/forum.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/icons/Icon.astro';
import { forumPosts, getForumPost } from '../data/forum';
import { pageTitle } from '../config/seo';
import { breadcrumbSchema, discussionForumPostingSchema } from '../utils/schema';
import {
  getTranslations,
  localizePath,
  type Locale,
} from '../i18n';
import { forumPostPath, normalizeInternalPath } from '../utils/path';

interface Props {
  slug: string;
  locale: Locale;
}

const { slug, locale } = Astro.props;
const t = getTranslations(locale);
const L = (path: string) => localizePath(locale, path);
const post = getForumPost(slug);
if (!post) return Astro.redirect(L('/forum/'));

const path = forumPostPath(post.slug, locale);
const forumLabel = t.nav.find((n) => n.href === '/forum/')?.label ?? 'Forum';
const breadcrumbs = [
  { name: 'Home', path: L('/') },
  { name: forumLabel, path: L('/forum/') },
  { name: post.category, path: L('/forum/') },
  { name: post.title, path },
];
const relatedPosts = [
  ...forumPosts.filter((item) => item.slug !== post.slug && item.category === post.category),
  ...forumPosts.filter((item) => item.slug !== post.slug && item.category !== post.category),
].slice(0, 3);

const localizeHref = (href?: string) => {
  if (!href) return L('/blog/');
  const normalized = normalizeInternalPath(href);
  return normalized.startsWith('http') ? normalized : L(normalized);
};
---

<BaseLayout
  locale={locale}
  title={pageTitle(post.title, undefined, locale)}
  description={post.excerpt}
  jsonLd={[
    discussionForumPostingSchema({
      name: post.title,
      text: post.body.join('\n\n'),
      url: path,
      author: post.author,
      comments: post.commentsCount,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="forum-page py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="forum-layout forum-layout--detail">
        <main class="forum-main">
          <article class="forum-detail-card" data-forum-vote data-post-slug={post.slug} data-upvotes={post.upvotes}>
            <div class="forum-vote forum-vote--detail" aria-label="Discussion voting">
              <button class="forum-vote__up" type="button" data-vote-up aria-label="Upvote this discussion">
                <Icon name="chevronDown" size={17} />
              </button>
              <strong data-vote-count>{post.upvotes}</strong>
              <button type="button" disabled aria-label="Downvoting is unavailable">
                <Icon name="chevronDown" size={17} />
              </button>
            </div>
            <div class="forum-detail-content">
              <div class="forum-post-meta">
                <span class={`forum-community-avatar tone-${post.categoryTone}`}>
                  <Icon name="users" size={15} />
                </span>
                <a href={L('/forum/')} class="forum-community-name">
                  d/{post.category.toLowerCase().replaceAll(' ', '')}
                </a>
                <span>·</span>
                <span><Icon name="userRound" size={13} /> Aion 2 Cheats guide team</span>
                <span>Guide-based Q&amp;A</span>
              </div>
              <h1>{post.title}</h1>
              {post.flair && <span class={`forum-flair tone-${post.categoryTone}`}>{post.flair}</span>}
              <div class="forum-detail-copy">{post.body.map((paragraph) => <p>{paragraph}</p>)}</div>
              {
                post.sourceTitle && (
                  <p class="forum-source forum-source--detail">
                    Based on: <a href={localizeHref(post.sourcePath)}>{post.sourceTitle}</a>
                  </p>
                )
              }
              <div class="forum-post-actions forum-post-actions--detail">
                <a href="#comments">
                  <Icon name="messageCircle" size={16} /> {post.commentsCount} guide replies
                </a>
                <a href={localizeHref(post.sourcePath)}>
                  <Icon name="navBlog" size={15} /> {t.blog.read}
                </a>
              </div>
              <div class="forum-login-prompt">
                <span class="forum-user-dot">i</span>
                <span>Preview discussion</span>
                <span>Posting and voting are unavailable here</span>
              </div>
              <section class="forum-comments" id="comments" aria-labelledby="comments-title">
                <div class="forum-comments__heading">
                  <h2 id="comments-title">Guide replies <span>{post.commentsCount}</span></h2>
                  <span>From the source article</span>
                </div>
                {
                  post.comments.map((comment) => (
                    <article class="forum-comment">
                      <div class="forum-comment__rail">
                        <span class="forum-comment__avatar">
                          <Icon name="userRound" size={14} />
                        </span>
                        <span class="forum-comment__line"></span>
                      </div>
                      <div class="forum-comment__body">
                        <div class="forum-comment__meta"><b>Guide answer</b></div>
                        <p>{comment.body}</p>
                        {comment.replies?.map((reply) => (
                          <div class="forum-comment forum-comment--reply">
                            <div class="forum-comment__rail">
                              <span class="forum-comment__avatar">{reply.author.slice(0, 1).toUpperCase()}</span>
                            </div>
                            <div class="forum-comment__body">
                              <div class="forum-comment__meta">
                                <b>u/{reply.author}</b>
                                <span>·</span>
                                <span>{reply.age}</span>
                              </div>
                              <p>{reply.body}</p>
                            </div>
                          </div>
                        ))}
                      </div>
                    </article>
                  ))
                }
              </section>
            </div>
          </article>
        </main>
        <aside class="forum-sidebar">
          <section class="forum-side-card forum-about">
            <div class="forum-side-card__banner"></div>
            <div class="forum-about__content">
              <div class="forum-about__title">
                <span class={`forum-community-avatar tone-${post.categoryTone}`}>d</span>
                <h2>d/{post.category.toLowerCase().replaceAll(' ', '')}</h2>
              </div>
              <p>Browse answers summarized from Aion 2 Cheats guides.</p>
              <div class="forum-stats">
                <span><b>{forumPosts.length}</b> guide discussions</span>
                <span>
                  <b>{forumPosts.filter((item) => item.category === post.category).length}</b> in this topic
                </span>
              </div>
              <a class="forum-join" href={L('/forum/')}>{forumLabel}</a>
            </div>
          </section>
          <section class="forum-side-card forum-related-card" aria-labelledby="forum-related-title">
            <h2 class="forum-side-heading" id="forum-related-title">More discussions</h2>
            <ul class="forum-related-list">
              {
                relatedPosts.map((item) => (
                  <li>
                    <a href={forumPostPath(item.slug, locale)}>
                      <span class="forum-related-list__category">{item.category}</span>
                      <b>{item.title}</b>
                      <span class="forum-related-list__meta">
                        {item.commentsCount} guide answers <Icon name="arrowRight" size={14} />
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="forum-related-card__all" href={L('/forum/')}>
              View all discussions <Icon name="arrowRight" size={14} />
            </a>
          </section>
        </aside>
      </div>
    </div>
  </section>
  <script>
    import { initForumVotes } from '../scripts/forum-votes.ts';
    initForumVotes();
  </script>
</BaseLayout>
