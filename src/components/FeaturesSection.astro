---
import { getTranslations, localeFromPathname } from '../i18n';
const locale = localeFromPathname(Astro.url.pathname);
const t = getTranslations(locale);
import { featureIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';

const s = t.features;

function isScriptsHero(title: string) {
  return title === 'Scripts' || title === 'Skill Assist';
}
---

<section id="features" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="features-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="features-title" />

    <div
      class="features-bento mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-12 lg:grid-rows-[repeat(6,auto)] lg:items-stretch lg:gap-4"
    >
      {
        s.items.map((item) => {
          const aimbotHero = isScriptsHero(item.title);
          return (
            <article
              class:list={[
                'group flex h-full min-h-0 flex-col overflow-hidden rounded-2xl border border-border bg-card text-left shadow-sm transition-colors hover:border-primary/35',
                item.bento ?? 'sm:col-span-2 lg:col-span-4',
                aimbotHero && 'features-bento-card--scripts',
              ]}
            >
              {
                aimbotHero ? (
                  <>
                    <header class="card-title-band px-5 py-4 sm:px-6 sm:py-5">
                      <div class="flex items-start gap-3">
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10">
                          <Icon name={featureIcons[item.title] ?? 'crosshair'} size={20} />
                        </span>
                        <div class="min-w-0 space-y-1.5">
                          <h3 class="font-[family-name:var(--font-heading)] text-lg font-bold leading-tight text-foreground md:text-xl">
                            {item.title}
                          </h3>
                          <p class="text-sm font-medium leading-snug text-neutral-900 dark:text-neutral-300">
                            {item.subtitle}
                          </p>
                        </div>
                      </div>
                    </header>

                    <div class="features-bento-scripts__body flex min-h-0 flex-1 flex-col gap-4 px-5 py-4 sm:gap-5 sm:px-6 sm:py-5">
                      <p class="text-sm leading-relaxed text-muted-foreground">{item.desc}</p>

                      {
                        item.bullets && item.bullets.length > 0 && (
                          <ul class="space-y-2.5 text-sm text-muted-foreground">
                            {item.bullets.map((b) => (
                              <li class="flex items-start gap-2.5">
                                <Icon name="check" size={14} class="mt-0.5 shrink-0 text-primary" />
                                <span class="leading-snug">{b}</span>
                              </li>
                            ))}
                          </ul>
                        )
                      }
                    </div>

                    <div class="card-footer-band mt-auto flex flex-wrap items-center gap-2 px-5 py-3 sm:px-6 sm:py-3.5">
                      {item.tags.map((tag) => (
                        <Badge variant="secondary" class="text-[11px]">
                          {tag}
                        </Badge>
                      ))}
                    </div>
                  </>
                ) : (
                  <>
                    <header class="card-title-band space-y-2 px-5 py-4 sm:px-6">
                      <div class="flex items-start gap-2.5">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary/10">
                          <Icon name={featureIcons[item.title] ?? 'crosshair'} size={18} />
                        </span>
                        <div class="min-w-0 space-y-1">
                          <h3 class="font-[family-name:var(--font-heading)] text-base font-bold leading-tight text-foreground md:text-lg">
                            {item.title}
                          </h3>
                          <p class="text-sm font-medium leading-snug text-neutral-900 dark:text-neutral-300">
                            {item.subtitle}
                          </p>
                        </div>
                      </div>
                    </header>

                    <div class="flex min-h-0 flex-1 flex-col gap-3 px-5 py-4 sm:px-6">
                      <p class="text-sm leading-relaxed text-muted-foreground">{item.desc}</p>

                      {
                        item.bullets && item.bullets.length > 0 && (
                          <ul class="space-y-2 text-sm text-muted-foreground">
                            {item.bullets.map((b) => (
                              <li class="flex items-start gap-2.5">
                                <Icon name="check" size={14} class="mt-0.5 shrink-0" />
                                <span class="leading-snug">{b}</span>
                              </li>
                            ))}
                          </ul>
                        )
                      }
                    </div>

                    <div class="card-footer-band mt-auto flex flex-wrap gap-1.5 px-5 py-3 sm:px-6">
                      {item.tags.map((tag) => (
                        <Badge variant="secondary" class="text-[11px]">
                          {tag}
                        </Badge>
                      ))}
                    </div>
                  </>
                )
              }
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .features-bento-scripts__body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
      align-items: start;
      column-gap: 2.5rem;
      row-gap: 0;
    }

    .features-bento-scripts__body > p {
      margin: 0;
    }

    .features-bento-scripts__body > ul {
      margin: 0;
    }
  }
</style>
