---
import '../styles/blog-sidebar.css';
import Icon from './icons/Icon.astro';
import { blogPostPath, productPath, ROUTES } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { getTranslations, localeFromPathname, localizePath } from '../i18n';
const locale = localeFromPathname(Astro.url.pathname);
const t = getTranslations(locale);
import type { BlogPostFull } from '../data/blog';
import type { IconName } from './icons/types';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';

interface Props {
  post: BlogPostFull;
  related: BlogPostFull[];
  class?: string;
}

const { post, related, class: className } = Astro.props;

const tocCount = post.body.filter((b) => b.type === 'h2').length;

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

const toc = post.body
  .filter((block) => block.type === 'h2' || block.type === 'h3')
  .map((block) => ({
    level: block.type as 'h2' | 'h3',
    text: 'text' in block ? block.text : '',
    id: slugify('text' in block ? block.text : ''),
  }));

const productLinks: { label: string; href: string; icon: IconName }[] = [
  { label: t.products.title, href: localizePath(locale, ROUTES.products), icon: 'sidebarHub' },
  { label: t.cheats.title, href: localizePath(locale, ROUTES.productsElite), icon: 'sidebarElite' },
  { label: 'Costume Changer', href: productPath('unlock-all', locale), icon: 'sidebarSkin' },
  { label: 'HWID Spoofer', href: productPath('hwid-spoofer', locale), icon: 'sidebarHwid' },
  { label: 'UGC', href: productPath('ugc', locale), icon: 'sidebarUgc' },
];
---

<aside
  class:list={[
    'blog-sidebar min-w-0 lg:sticky lg:top-[calc(var(--floating-nav-clearance)+0.5rem)] lg:max-h-[calc(100vh-var(--floating-nav-clearance)-1rem)] lg:self-start lg:overflow-y-auto lg:overflow-x-hidden lg:pr-0.5',
    className,
  ]}
  aria-label="Article sidebar"
>
  {
    toc.length > 0 && (
      <section class="blog-sidebar__block" aria-labelledby="blog-sidebar-toc-title">
        <h2 id="blog-sidebar-toc-title" class="blog-sidebar__heading">
          <Icon name="layers" size={14} class="text-primary" aria-hidden="true" />
          <span class="blog-sidebar__heading-text">In this article</span>
          {tocCount > 0 && (
            <Badge variant="secondary" size="sm" class="h-5 shrink-0 rounded-full px-1.5 tabular-nums text-[10px]">
              {tocCount}
            </Badge>
          )}
        </h2>
        <nav aria-label="Table of contents">
          <ul class="blog-sidebar__toc-list" data-blog-toc>
            {toc.map((item) => (
              <li class:list={[item.level === 'h3' && 'blog-sidebar__toc-item--nested']}>
                <button
                  type="button"
                  class="blog-sidebar__toc-link blog-toc-link truncate"
                  data-toc-target={item.id}
                  title={item.text}
                >
                  {item.text}
                </button>
              </li>
            ))}
          </ul>
        </nav>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="blog-sidebar__block" aria-labelledby="blog-sidebar-related-title">
        <h2 id="blog-sidebar-related-title" class="blog-sidebar__heading">
          <Icon name="navBlog" size={14} class="text-primary" aria-hidden="true" />
          Related guides
        </h2>
        <ul class="blog-sidebar__list">
          {related.map((item) => (
            <li>
              <a href={blogPostPath(item.slug, locale)} class="blog-sidebar__link" title={item.title}>
                <Icon name="arrowUpRight" size={13} class="shrink-0 opacity-70" aria-hidden="true" />
                <span class="blog-sidebar__truncate">{item.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="blog-sidebar__block blog-sidebar__block--shop" aria-labelledby="blog-sidebar-products-title">
    <h2 id="blog-sidebar-products-title" class="blog-sidebar__heading">
      <Icon name="navProducts" size={14} class="text-primary" aria-hidden="true" />
      Our products
    </h2>
    <ul class="blog-sidebar__list">
      {productLinks.map((link) => (
        <li>
          <a href={link.href} class="blog-sidebar__link" title={link.label}>
            <Icon name={link.icon} size={13} class="shrink-0 text-primary" aria-hidden="true" />
            <span class="blog-sidebar__truncate">{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <Button
      as="a"
      href={checkoutPath('aion2')}
      variant="primary"
      size="sm"
      class="blog-sidebar__cta mt-2.5 w-full min-w-0 justify-start"
      aria-label={t.ui.checkoutAria}
    >
      <span class="truncate">Buy Aion 2 Cheats</span>
      <Icon name="arrowRight" size={16} class="shrink-0" />
    </Button>
  </section>
</aside>

<script>
  const tocRoot = document.querySelector('[data-blog-toc]');
  if (tocRoot) {
    const links = [...tocRoot.querySelectorAll<HTMLButtonElement>('[data-toc-target]')];
    const headings = links
      .map((link) => document.getElementById(link.getAttribute('data-toc-target')!))
      .filter((el): el is HTMLElement => Boolean(el));

    links.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.getAttribute('data-toc-target');
        if (!id) return;
        document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    if (headings.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (!visible) return;

          links.forEach((link) => link.classList.remove('is-active'));
          const active = links.find(
            (link) => link.getAttribute('data-toc-target') === visible.target.id,
          );
          active?.classList.add('is-active');
        },
        { rootMargin: '-20% 0px -55% 0px', threshold: [0, 0.25, 0.5, 1] },
      );

      headings.forEach((heading) => observer.observe(heading));
    }
  }
</script>
