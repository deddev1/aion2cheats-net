---
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_META,
  localizePath,
  stripLocalePrefix,
  type Locale,
} from '../i18n/locales';
import Icon from './icons/Icon.astro';

interface Props {
  locale: Locale;
  class?: string;
  /** Compact trigger for mobile sheet */
  compact?: boolean;
}

const { locale, class: className, compact = false } = Astro.props;
const barePath = stripLocalePrefix(Astro.url.pathname);
const current = LOCALE_META[locale];
const priority = LOCALES.filter((code) => LOCALE_META[code].priority);
const secondary = LOCALES.filter((code) => !LOCALE_META[code].priority);
---

<div class:list={['lang-switcher relative', className]} data-lang-switcher>
  <button
    type="button"
    class:list={[
      'lang-switcher__trigger inline-flex items-center gap-1.5 rounded-lg border border-border/80 bg-background/50 font-medium text-foreground transition-colors hover:bg-muted',
      compact ? 'h-9 px-2.5 text-xs' : 'h-9 px-2.5 text-sm',
    ]}
    aria-expanded="false"
    aria-haspopup="listbox"
    aria-label={`Language: ${current.nativeName}`}
    data-lang-trigger
  >
    <Icon name="globe" size={compact ? 15 : 16} class="shrink-0 text-muted-foreground" />
    <span class="max-w-[5.5rem] truncate">{current.nativeName}</span>
    <Icon name="chevronDown" size={14} class="shrink-0 text-muted-foreground" />
  </button>

  <div
    class="lang-switcher__menu absolute right-0 z-50 mt-2 hidden min-w-[13.5rem] overflow-hidden rounded-xl border border-border bg-background/95 p-1 shadow-lg backdrop-blur-xl"
    role="listbox"
    aria-label="Select language"
    data-lang-menu
  >
    <p class="px-2.5 pb-1 pt-2 text-[0.65rem] font-semibold uppercase tracking-wide text-muted-foreground">
      Priority markets
    </p>
    {
      priority.map((code) => {
        const meta = LOCALE_META[code];
        const href = localizePath(code, barePath);
        const active = code === locale;
        return (
          <a
            href={href}
            hrefLang={meta.hreflang}
            role="option"
            aria-selected={active}
            class:list={[
              'flex items-center justify-between gap-2 rounded-lg px-2.5 py-2 text-sm transition-colors',
              active
                ? 'bg-primary/12 font-semibold text-foreground'
                : 'text-muted-foreground hover:bg-muted hover:text-foreground',
            ]}
            data-lang-option={code}
          >
            <span>{meta.nativeName}</span>
            <span class="text-[0.7rem] text-muted-foreground">{meta.englishName}</span>
          </a>
        );
      })
    }
    <p class="px-2.5 pb-1 pt-2 text-[0.65rem] font-semibold uppercase tracking-wide text-muted-foreground">
      More languages
    </p>
    {
      secondary.map((code) => {
        const meta = LOCALE_META[code];
        const href = localizePath(code, barePath);
        const active = code === locale;
        return (
          <a
            href={href}
            hrefLang={meta.hreflang}
            role="option"
            aria-selected={active}
            class:list={[
              'flex items-center justify-between gap-2 rounded-lg px-2.5 py-2 text-sm transition-colors',
              active
                ? 'bg-primary/12 font-semibold text-foreground'
                : 'text-muted-foreground hover:bg-muted hover:text-foreground',
            ]}
            data-lang-option={code}
          >
            <span>{meta.nativeName}</span>
            <span class="text-[0.7rem] text-muted-foreground">{meta.englishName}</span>
          </a>
        );
      })
    }
    {
      locale !== DEFAULT_LOCALE && (
        <a
          href={localizePath(DEFAULT_LOCALE, barePath)}
          class="mt-1 flex items-center gap-2 rounded-lg border-t border-border px-2.5 py-2 text-xs text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          English (default)
        </a>
      )
    }
  </div>
</div>

<style>
  .lang-switcher[data-open] .lang-switcher__menu {
    display: block;
  }
</style>

<script>
  function bindLangSwitchers() {
    document.querySelectorAll<HTMLElement>('[data-lang-switcher]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const trigger = root.querySelector<HTMLButtonElement>('[data-lang-trigger]');
      const menu = root.querySelector<HTMLElement>('[data-lang-menu]');
      if (!trigger || !menu) return;

      const close = () => {
        root.removeAttribute('data-open');
        trigger.setAttribute('aria-expanded', 'false');
      };
      const open = () => {
        root.setAttribute('data-open', '');
        trigger.setAttribute('aria-expanded', 'true');
      };

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        if (root.hasAttribute('data-open')) close();
        else open();
      });

      document.addEventListener('click', (event) => {
        if (!root.contains(event.target as Node)) close();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close();
      });
    });
  }

  bindLangSwitchers();
  document.addEventListener('astro:page-load', bindLangSwitchers);
</script>
