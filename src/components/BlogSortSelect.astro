---
import { getTranslations, localeFromPathname } from '../i18n';
const locale = localeFromPathname(Astro.url.pathname);
const t = getTranslations(locale);
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/types';
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/starwind/select';

interface Props {
  id?: string;
}

const { id = 'blog-sort-select' } = Astro.props;

const sortOptions: { value: string; label: string; icon: IconName }[] = [
  { value: 'newest', label: t.blog.sortNewest, icon: 'calendar' },
  { value: 'oldest', label: t.blog.sortOldest, icon: 'fieldCalendar' },
  { value: 'short', label: t.blog.sortShortRead, icon: 'clock' },
  { value: 'long', label: t.blog.sortLongRead, icon: 'heroStatClock' },
];
---

<div id={id} class="flex w-full flex-col gap-1.5 sm:w-auto sm:min-w-[12rem]">
  <span class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
    <Icon name="settings" size={14} class="text-primary" aria-hidden="true" />
    {t.blog.sortLabel}
  </span>
  <Select defaultValue="newest" name="blog-sort" class="relative w-full">
    <SelectTrigger size="sm" aria-label={t.blog.sortLabel} class="w-full min-w-[12rem]">
      <Icon name="refresh" size={15} class="shrink-0 text-primary" aria-hidden="true" />
      <SelectValue placeholder={t.blog.sortNewest} />
    </SelectTrigger>
    <SelectContent
      size="sm"
      align="end"
      side="bottom"
      sideOffset={8}
      alignItemWithTrigger={false}
      avoidCollisions
    >
      {
        sortOptions.map((option) => (
          <SelectItem value={option.value}>
            <span class="flex items-center gap-2">
              <Icon name={option.icon} size={15} class="shrink-0 text-muted-foreground" aria-hidden="true" />
              {option.label}
            </span>
          </SelectItem>
        ))
      }
    </SelectContent>
  </Select>
</div>
