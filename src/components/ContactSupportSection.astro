---
import '../styles/support-section.css';
import { getTranslations, localeFromPathname, localizePath } from '../i18n';
const locale = localeFromPathname(Astro.url.pathname);
const t = getTranslations(locale);
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/types';
import { Button } from '@/components/starwind/button';
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/starwind/card';

interface Props {
  titleId?: string;
  showTicketTips?: boolean;
  class?: string;
}

const { titleId = 'support-title', showTicketTips = false, class: className } = Astro.props;
const c = t.support;
---

<section
  id="support"
  class:list={['support-section border-y border-border bg-muted/20 py-16 md:py-24', className]}
  aria-labelledby={titleId}
>
  <div class="support-section__inner mx-auto max-w-6xl px-5">
    <header class="section-header section-header--wide support-section__header">
      <p class="section-header__eyebrow">{c.eyebrow}</p>
      <h1 id={titleId} class="section-header__title">{c.title}</h1>
      <p class="section-header__subtitle">{c.subtitle}</p>
    </header>

    <ul class="support-section__cards">
      {
        c.channels.map((channel) => (
          <li>
            <Card class="group flex h-full flex-col transition-shadow hover:shadow-md">
              <CardHeader class="space-y-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-primary/10">
                  <Icon name={channel.icon as IconName} size={22} class="support-section__icon" />
                </div>
                <CardTitle class="text-lg normal-case">{channel.title}</CardTitle>
              </CardHeader>
              <CardContent class="flex-1">
                <p class="text-sm leading-relaxed text-muted-foreground">{channel.desc}</p>
              </CardContent>
              <CardFooter>
                <Button
                  as="a"
                  href={channel.href}
                  variant="outline"
                  size="sm"
                  class="w-full"
                >
                  {channel.linkLabel}
                  <Icon name="arrowRight" size={17} />
                </Button>
              </CardFooter>
            </Card>
          </li>
        ))
      }
    </ul>

    {
      showTicketTips && (
        <div class="support-section__tips">
          <h3 class="support-section__tips-title">{c.ticketTitle}</h3>
          <ul class="support-section__tips-list">
            {c.ticketItems.map((item) => (
              <li class="support-section__tips-item">
                <p class="support-section__tips-item-title">{item.title}</p>
                <p class="support-section__tips-item-desc">{item.desc}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
