---
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import { blogTagIcons } from '../data/sectionIcons';
import type { BlogPost } from '../i18n/types';
import type { IconName } from './icons/types';
import { Badge } from '@/components/starwind/badge';
import { getTranslations, localeFromPathname, localizePath } from '../i18n';
import { englishBlogTag } from '../i18n/blog/localize';

interface Props {
  post: BlogPost;
  class?: string;
}

const { post, class: className } = Astro.props;
const locale = localeFromPathname(Astro.url.pathname);
const t = getTranslations(locale);
const tagIcon: IconName = blogTagIcons[englishBlogTag(post.tag)] ?? blogTagIcons[post.tag] ?? 'tag';
const blogHref = localizePath(locale, ROUTES.blog);
---

<div class:list={['blog-article__toolbar', className]}>
  <a href={blogHref} class="blog-article__toolbar-back shrink-0">
    <Icon name="chevronLeft" size={15} aria-hidden="true" />
    {t.blog.viewAll}
  </a>
  <div class="blog-article__toolbar-meta">
    <Badge variant="secondary" size="sm" class="blog-article__toolbar-badge max-w-[9rem] gap-1 rounded-full" title={post.tag}>
      <Icon name={tagIcon} size={12} class="shrink-0" />
      <span class="truncate">{post.tag}</span>
    </Badge>
    <Badge variant="outline" size="sm" class="blog-article__toolbar-badge max-w-[7rem] gap-1 rounded-full" title={post.readTime}>
      <Icon name="clock" size={12} class="shrink-0" />
      <span class="truncate">{post.readTime}</span>
    </Badge>
    <Badge variant="outline" size="sm" class="blog-article__toolbar-badge max-w-[8.5rem] gap-1 rounded-full" title={post.date}>
      <Icon name="calendar" size={12} class="shrink-0" />
      <span class="truncate">{post.date}</span>
    </Badge>
  </div>
</div>
